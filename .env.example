# Get a key from OpenRouter. Check current model slugs at https://openrouter.ai/models
OPENROUTER_API_KEY=
LABYRINTH_MODEL=anthropic/claude-haiku-5.5
ANALYST_MODEL=anthropic/claude-sonnet-5.5
ATTACKER_MODEL=deepseek/deepseek-v4.1-flash
ATTACKER_REASONING={"effort":"medium"}

# Set to heuristic to disable analyst LLM calls even when a key exists.
ANALYST=openrouter
COUNTERPROMPT_ENABLED=true

# Optional: POST a JSON alert {session, source, reason, ts} here on every flag.
ALERT_WEBHOOK_URL=

# Optional: HMAC secret for the cp_id sticky-identity cookie. Random per run if unset.
CP_COOKIE_SECRET=
